# File ignorati durante il build Docker
# Evita di copiare secrets (.env), file di sviluppo e artefatti nel container.
# I secret sono passati dai file docker/.env via docker-compose environment.

# Environment & secrets
.env
.env.*
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*

# Git
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
*.egg-info

# Node
node_modules
npm-debug.log
yarn-debug.log
yarn-error.log

# IDE
.idea
.vscode
*.swp

# OS
.DS_Store
Thumbs.db

# Build artefatti
build/
dist/
*.log

